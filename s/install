# Install (or reinstall) the `anarchie` binary from this checkout.
#
# anarchie is a single crate at the repository root, so this is a plain
# `cargo install --path .`, plus:
#   --force   so re-running always replaces the installed binary with this
#             build - the whole point of the script. It also overwrites a
#             binary left behind by an older package name (the pre-condensation
#             `anarchie-cli`), which a plain install refuses to touch.
#   --locked  install from the committed Cargo.lock, so it is reproducible.
# Any extra arguments are passed through to cargo install.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

exec cargo install --path . --locked --force "$@"
